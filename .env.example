# LiveKit room transport and LiveKit Inference authentication.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=retail-support-agent

# LiveKit Inference model descriptors. Provider API keys are not required for these.
RETAIL_STT_MODEL=assemblyai/universal-3-5-pro:en
RETAIL_LLM_MODEL=google/gemma-4-31b-it
RETAIL_TTS_MODEL=fishaudio/s2.1-pro:fa4c9eb3dccc4806b382b40d61c6b10a

# VAD-only turn handling; no semantic turn detector is used.
RETAIL_VAD_MODEL=silero
RETAIL_MIN_ENDPOINTING_DELAY=0.5
RETAIL_MAX_ENDPOINTING_DELAY=3.0
RETAIL_MAX_TOOL_STEPS=8

# Structured events are sent over reliable LiveKit room data for Module 2. This is independent
# of LiveKit's recording and observability callbacks.
RETAIL_TRACE_EVENTS=1

# Module 2 defaults to three isolated rooms and permits a maximum of five.
EVAL_OUTPUT_DIR=eval-runs
EVAL_CONCURRENCY=3
EVAL_TASK_TIMEOUT_SECONDS=360
EVAL_REPORT_TIMEOUT_SECONDS=20

# The evaluator caller has an independent voice pipeline. These may be changed without changing
# the retail agent, and may later be replaced with provider objects in Python.
EVAL_STT_MODEL=assemblyai/universal-3-5-pro:en
EVAL_LLM_MODEL=google/gemma-4-31b-it
EVAL_TTS_MODEL=fishaudio/s2.1-pro:fa4c9eb3dccc4806b382b40d61c6b10a
EVAL_VAD_MODEL=silero

# Optional: replace the default tau retail environment loader.
# The callable must return retail_agent.runtime.RuntimeBindings.
RETAIL_BINDINGS_FACTORY=retail_agent.integrations.tau:load_default_retail_bindings

# Tau installs its Python package but not its benchmark data in the wheel. Point this at
# the data/ directory of a tau2-bench checkout used by the runtime.
TAU2_DATA_DIR=/absolute/path/to/tau2-bench/data

# Optional direct-provider credentials. These are unused by the default Inference setup.
# OPENAI_API_KEY=
# DEEPGRAM_API_KEY=
# CARTESIA_API_KEY=
